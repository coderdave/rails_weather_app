<% content_for :title, "Rails Weather App" %>

<main>
  <section class="weather-panel" aria-labelledby="weather-app-title" data-controller="forecast-search" data-forecast-search-minimum-length-value="<%= @minimum_location_length %>">
    <h1 id="weather-app-title">Rails Weather App</h1>

    <%= form_with url: root_path, method: :get, local: true, class: "search-form", data: { forecast_search_target: "searchForm", action: "submit->forecast-search#submit" } do |form| %>
      <%= form.label :location, "Location", class: "visually-hidden" %>
      <%= form.search_field :location,
        value: @location_query,
        placeholder: "Search for a location",
        class: "location-input",
        autocomplete: "street-address",
        autofocus: true,
        data: {
          forecast_search_target: "locationInput",
          action: "input->forecast-search#handleInput keydown.enter->forecast-search#submit"
        } %>

      <%= form.button type: "submit", class: "search-button", disabled: @search_disabled, data: { forecast_search_target: "searchButton" } do %>
        <span class="spinner" hidden data-forecast-search-target="loadingSpinner" aria-hidden="true"></span>
        <span data-forecast-search-target="searchButtonText">Search</span>
      <% end %>
    <% end %>

    <p class="loading-status" aria-live="polite" data-forecast-search-target="loadingStatus"></p>

    <% if @location_error %>
      <p class="location-error" aria-live="polite" data-forecast-search-target="forecastResult"><%= @location_error %></p>
    <% end %>

    <% if @forecast %>
      <section class="forecast-result" aria-live="polite" data-forecast-search-target="forecastResult">
        <h2>Here's your forecast...</h2>
        <p class="forecast-location"><%= @forecast.location %></p>

        <dl class="forecast-details">
          <div>
            <dt>Current</dt>
            <dd><%= @forecast.current_temperature %>&deg;F</dd>
          </div>
          <div>
            <dt>High</dt>
            <dd><%= @forecast.high_temperature %>&deg;F</dd>
          </div>
          <div>
            <dt>Low</dt>
            <dd><%= @forecast.low_temperature %>&deg;F</dd>
          </div>
          <div>
            <dt>Conditions</dt>
            <dd><%= @forecast.conditions %></dd>
          </div>
        </dl>

        <% if @forecast.extended_periods.any? %>
          <section class="extended-forecast" aria-labelledby="extended-forecast-title">
            <h3 id="extended-forecast-title">Extended Forecast</h3>

            <ul class="extended-forecast-list">
              <% @forecast.extended_periods.each do |period| %>
                <li>
                  <p class="extended-forecast-name"><%= period.name %></p>
                  <p class="extended-forecast-details">
                    <%= period.conditions %>, <%= period.temperature %>&deg;F
                  </p>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>

        <% if @forecast.cached? %>
          <p class="cache-status">(cached result)</p>
        <% end %>
      </section>
    <% end %>
  </section>
</main>
